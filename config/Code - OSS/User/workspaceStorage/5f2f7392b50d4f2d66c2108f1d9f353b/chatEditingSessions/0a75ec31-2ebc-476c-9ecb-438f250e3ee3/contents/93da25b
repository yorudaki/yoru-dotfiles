* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, Helvetica, sans-serif;
}

body {
  background-color: #eef3f9;
}

header {
  background-color: #0f2a4a;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 60px;
  border-bottom: 3px solid #4ab8d4;
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.logo img {
  width: 46px;
  height: 46px;
  border-radius: 8px;
}

.logo h1 {
  color: white;
  font-size: 26px;
}

.navmenu {
  list-style: none;
  display: flex;
  gap: 30px;
}

.navmenu a {
  color: #a8c4de;
  text-decoration: none;
  font-size: 15px;
}

.navmenu a:hover {
  color: #8fd7ea;
}

.user-icon a {
  color: #a8c4de;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
}

.avatar {
  width: 38px;
  height: 38px;
  background-color: #1a3f6f;
  border: 2px solid #4ab8d4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8fd7ea;
  font-weight: bold;
}

.container-historico {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 40px;
  padding-bottom: 40px;
}

.card-historico {
  width: 860px;
  background: #ffffff;
  border-radius: 18px;
  padding: 40px;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  gap: 30px;
}

.header-historico {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.header-historico h1 {
  font-size: 42px;
  color: #0f172a;
}

.linha-decorativa {
  width: 140px;
  height: 4px;
  background-color: #2563eb;
  border-radius: 10px;
}

.lista-caixas {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.caixa-item {
  background: #f8fbff;
  border: 1px solid #d1d5db;
  border-radius: 12px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.caixa-item p {
  margin: 0;
  color: #0f2a4a;
  font-size: 15px;
}

.caixa-item .caixa-total {
  font-weight: 700;
  color: #2563eb;
  font-size: 18px;
}

.caixa-item .caixa-meta {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.actions {
  display: flex;
  justify-content: center;
}

.btn-voltar {
  background-color: #d1d5db;
  border: none;
  border-radius: 10px;
  padding: 12px 36px;
  color: #0f2a4a;
  font-weight: 700;
  cursor: pointer;
}

.btn-voltar:hover {
  background-color: #b6bac2;
}